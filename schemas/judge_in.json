{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judge input",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "The texts to judge. One invoke makes at most six Jev calls: one per 29 KB of code plus one for the comments.",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "A name for the text, usually its path; its extension names the language when language is absent."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180000,
            "description": "The source text."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The language key (go, python, typescript, java, c, cpp, rust, \u2026)."
          }
        },
        "required": [
          "ref",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
