{
  "id": "id.aiii.codequality",
  "version": "0.1.7",
  "aiios_min_version": "0.1.10",
  "plugin_family": "tool_bridge",
  "publisher": "AIII",
  "title": "Code quality (Jev)",
  "description": "Measures source code quality with TypeSafe's Jev as the judge: a fixed catalogue of fault statements asked about each file's code and, separately, its comments; answers scored into findings, six dimension scores, an index and a band. Judges texts passed in, or scans a folder in the identity's sandbox a few files per call.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aiii-dot-id/aii-codequality-plugin",
  "interface": {
    "id": "id.aiii.codequality.core",
    "version": 1
  },
  "capability_envelope": [
    "net.outbound:api.typesafe.ai:443",
    "fs.sandbox",
    "fs.private"
  ],
  "variants": [
    {
      "variant_id": "linux-x86_64-wasm",
      "platform": "linux",
      "arch": "x86_64",
      "topology": "full_identity_host",
      "execution_runtime": "wasm_component",
      "admission_profile": "wasm_sandbox",
      "variant_capabilities": [
        "net.outbound:api.typesafe.ai:443",
        "fs.sandbox",
        "fs.private"
      ]
    },
    {
      "variant_id": "linux-arm64-wasm",
      "platform": "linux",
      "arch": "arm64",
      "topology": "full_identity_host",
      "execution_runtime": "wasm_component",
      "admission_profile": "wasm_sandbox",
      "variant_capabilities": [
        "net.outbound:api.typesafe.ai:443",
        "fs.sandbox",
        "fs.private"
      ]
    },
    {
      "variant_id": "macos-arm64-wasm",
      "platform": "macos",
      "arch": "arm64",
      "topology": "full_identity_host",
      "execution_runtime": "wasm_component",
      "admission_profile": "wasm_sandbox",
      "variant_capabilities": [
        "net.outbound:api.typesafe.ai:443",
        "fs.sandbox",
        "fs.private"
      ]
    },
    {
      "variant_id": "windows-x86_64-wasm",
      "platform": "windows",
      "arch": "x86_64",
      "topology": "full_identity_host",
      "execution_runtime": "wasm_component",
      "admission_profile": "wasm_sandbox",
      "variant_capabilities": [
        "net.outbound:api.typesafe.ai:443",
        "fs.sandbox",
        "fs.private"
      ]
    }
  ],
  "settings": [
    {
      "key": "api_key",
      "type": "secret",
      "title": "Jev API key",
      "description": "TypeSafe's Jev key: paste it here; it is kept by AII OS and rides only to api.typesafe.ai",
      "required": true
    },
    {
      "key": "model",
      "type": "string",
      "title": "Jev model",
      "description": "the Jev model every request names; the list comes from Jev",
      "default": "jev-latest",
      "choices_from": "models"
    }
  ]
}
